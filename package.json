{
  "name": "dsh-marisa-ui-plugin",
  "version": "1.13.0",
  "type": "module",
  "description": "Marisa UI: a static aurora-glass theme for the DeepSeek Harness web UI — frosted panels, specular rims, chromatic edges and a drifting-look aurora backdrop without per-frame rendering cost.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LanluZ/dsh-marisa-ui-plugin.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "theme",
    "aurora",
    "glass",
    "ui"
  ],
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "README.md",
    "docs/API.md",
    "docs/assets/preview.webp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "license": "MIT"
}
